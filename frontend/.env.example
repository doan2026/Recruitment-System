# `demo` giữ bộ dữ liệu Stitch cho phát triển độc lập; đổi thành `gateway` khi
# Auth gọi setApiSession({ token?, accountId }) để đổi tài khoản xóa state ngay;
# gateway có thể dùng cookie HttpOnly nhưng vẫn phải phát session boundary.
NEXT_PUBLIC_API_MODE=demo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
