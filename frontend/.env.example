# gateway: login thật qua /login; demo: dữ liệu mẫu để phát triển độc lập.
NEXT_PUBLIC_API_MODE=gateway
# Same-origin proxy tránh phụ thuộc CORS của từng microservice.
NEXT_PUBLIC_API_BASE_URL=/api
# Gateway origin cho Next server; API client tự thêm /api cho mọi request.
# Local Docker: http://api-gateway; prod: http://api-gateway:8080.
API_INTERNAL_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
