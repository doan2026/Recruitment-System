SERVICE_NAME=application-service
PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB}?currentSchema=application
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
# Configure exactly one verification-key source. Static PEM is the local default.
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# JWT_JWKS_URI=https://auth-service/auth/.well-known/jwks.json
# JWT_JWKS_ALLOWED_HOSTS=auth-service
# JWT_ALLOW_INSECURE_JWKS=false
# JWT_JWKS_TIMEOUT_MS=3000
# JWT_JWKS_CACHE_TTL_MS=300000
# JWT_JWKS_REFRESH_COOLDOWN_MS=10000
JOB_SERVICE_URL=http://job-search-service:3000
COMPANY_SERVICE_URL=http://company-service:3000
PROFILE_SERVICE_URL=http://profile-service:3000
PROFILE_INTERNAL_API_KEY=replace-with-a-distinct-application-to-profile-key
AI_SERVICE_URL=http://ai-service:8000
INTERNAL_API_KEY=${INTERNAL_API_KEY}
INTERNAL_API_KEY_PROFILE=replace-with-a-distinct-profile-to-application-key
INTERNAL_API_KEY_INTERVIEW=replace-with-a-distinct-interview-to-application-key
KAFKA_BROKERS=kafka:9092
KAFKA_APPLICATION_TOPIC=application-events
OUTBOX_PUBLISH_DELAY_MS=1000
OFFER_EXPIRY_SCAN_DELAY_MS=60000
OFFER_EXPIRY_BATCH_SIZE=200
OFFER_EXPIRY_MAX_BATCHES_PER_SCAN=25
