SERVICE_NAME=admin-service
DATABASE_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB}?currentSchema=admin
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
JWT_JWKS_URI=http://auth-service:8080/auth/.well-known/jwks.json
JWT_ISSUER=${JWT_ISSUER}
JWT_AUDIENCE=${JWT_AUDIENCE}
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ADMIN_KAFKA_ENABLED=true
AUTH_SERVICE_URL=http://auth-service:8080
COMPANY_SERVICE_URL=http://company-service:3000
JOB_SERVICE_URL=http://job-search-service:3000
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
