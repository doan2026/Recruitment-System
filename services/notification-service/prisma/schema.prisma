generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  INTERVIEW_SCHEDULED
}

enum DeliveryChannel {
  IN_APP
  PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

model Notification {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  type          NotificationType
  title         String            @db.VarChar(160)
  body          String            @db.VarChar(500)
  payloadJson   Json              @map("payload_json")
  sourceTopic   String            @map("source_topic") @db.VarChar(100)
  sourceEventId String            @map("source_event_id") @db.Uuid
  readAt        DateTime?         @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  logs          NotificationLog[]

  @@unique([sourceTopic, sourceEventId, userId], map: "notifications_source_recipient_key")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_user_cursor_idx")
  @@map("notifications")
}

model ProcessedEvent {
  id            BigInt   @id @default(autoincrement())
  topic         String   @db.VarChar(100)
  eventId       String   @map("event_id") @db.Uuid
  eventKey      String   @map("event_key") @db.Uuid
  payloadSha256 String   @map("payload_sha256") @db.Char(64)
  schemaVersion Int?     @map("schema_version")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([topic, eventId], map: "processed_events_topic_event_key")
  @@map("processed_events")
}

model PoisonEvent {
  id             BigInt   @id @default(autoincrement())
  topic          String   @db.VarChar(100)
  partition      Int
  offset         BigInt
  eventKeySha256 String   @map("event_key_sha256") @db.Char(64)
  payloadSha256  String   @map("payload_sha256") @db.Char(64)
  errorCode      String   @map("error_code") @db.VarChar(80)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@unique([topic, partition, offset], map: "poison_events_topic_partition_offset_key")
  @@map("poison_events")
}

model DeviceToken {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  tokenHash       String         @unique(map: "device_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  tokenCiphertext String         @map("token_ciphertext") @db.Text
  platform        DevicePlatform
  lastUsedAt      DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId], map: "device_tokens_user_idx")
  @@map("device_tokens")
}

model NotificationLog {
  id             String          @id @default(uuid()) @db.Uuid
  notificationId String          @map("notification_id") @db.Uuid
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  attempt        Int             @default(0)
  errorCode      String?         @map("error_code") @db.VarChar(100)
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel], map: "notification_logs_notification_channel_key")
  @@index([status, createdAt], map: "notification_logs_status_created_idx")
  @@map("notification_logs")
}

model NotificationSetting {
  userId       String   @id @map("user_id") @db.Uuid
  emailEnabled Boolean  @default(true) @map("email_enabled")
  pushEnabled  Boolean  @default(true) @map("push_enabled")
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_settings")
}
