SERVICE_NAME=notification-service
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=notification
KAFKA_BROKERS=kafka:9092
KAFKA_APPLICATION_TOPIC=application-events
KAFKA_NOTIFICATION_GROUP_ID=notification-application-inbox-v1
KAFKA_INTERVIEW_TOPIC=interview-events
KAFKA_NOTIFICATION_INTERVIEW_GROUP_ID=notification-interview-inbox-v1
NOTIFICATION_KAFKA_CONSUMER_ENABLED=true
NOTIFICATION_EVENT_MAX_BYTES=65536
NOTIFICATION_APPLICATION_REPLAY_AFTER=2026-08-28T00:00:00.000Z
NOTIFICATION_INTERVIEW_REPLAY_AFTER=2026-08-28T00:00:00.000Z
NOTIFICATION_CURSOR_HMAC_KEY=replace-with-a-distinct-notification-cursor-secret
JWT_JWKS_URI=
JWT_ALLOW_INSECURE_JWKS=false
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=${SMTP_FROM}
FIREBASE_SERVICE_ACCOUNT_PATH=${FIREBASE_SERVICE_ACCOUNT_PATH}
