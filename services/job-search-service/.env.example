SERVICE_NAME=job-search-service
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=job
KAFKA_BROKERS=kafka:9092
JOB_EVENT_PUBLISHER_ENABLED=true
KAFKA_JOB_TOPIC=job-events
JOB_EVENT_OUTBOX_POLL_INTERVAL_MS=5000
JOB_EVENT_OUTBOX_LEASE_MS=30000
JOB_EVENT_KAFKA_REQUEST_TIMEOUT_MS=3000
JOB_EVENT_KAFKA_RETRIES=1
JOB_EVENT_KAFKA_RETRY_MAX_MS=500
JOB_EVENT_OUTBOX_BATCH_SIZE=100
JOB_EVENT_OUTBOX_RETRY_BASE_MS=1000
JOB_EVENT_OUTBOX_RETRY_MAX_MS=60000
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
ELASTICSEARCH_NODE=http://elasticsearch:9200
JOB_INDEX_QUEUE_NAME=job-search-indexing
JOB_INDEX_ATTEMPTS=8
JOB_INDEX_BACKOFF_MS=1000
JOB_INDEX_CONCURRENCY=5
JOB_INDEX_POLL_INTERVAL_MS=5000
JOB_INDEX_RECONCILE_MS=60000
JOB_INDEX_LEASE_MS=30000
JOB_INDEX_BATCH_SIZE=100
JOB_INDEX_REDIS_COMMAND_TIMEOUT_MS=2000
ELASTICSEARCH_INDEX=job_index_v4
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2000
JOB_SEARCH_CURSOR_HMAC_KEY=replace-with-at-least-32-random-cursor-key-bytes
JOB_SEARCH_MAX_OPEN_PITS=64
COMPANY_SERVICE_URL=http://company-service:3000
COMPANY_SERVICE_ALLOWED_HOSTS=company-service
COMPANY_REQUEST_TIMEOUT_MS=2000
PROFILE_SERVICE_URL=http://profile-service:3000
PROFILE_SERVICE_ALLOWED_HOSTS=profile-service
PROFILE_REQUEST_TIMEOUT_MS=2000
PROFILE_INTERNAL_API_KEY=replace-with-job-search-profile-scoped-key-at-least-32-bytes
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_ALLOWED_HOSTS=ai-service
AI_REQUEST_TIMEOUT_MS=2000
AI_INTERNAL_API_KEY=replace-with-job-search-scoped-key-at-least-32-bytes
AI_CANDIDATE_INTERNAL_API_KEY=replace-with-distinct-candidate-ranking-key-at-least-32-bytes
INTERNAL_API_KEY=${INTERNAL_API_KEY}
JOB_EXPIRY_INTERVAL_MS=3600000
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_JWKS_URI=https://auth.example/auth/.well-known/jwks.json
# JWT_JWKS_ALLOWED_HOSTS=auth.example
JWT_ALLOW_INSECURE_JWKS=false
JWT_JWKS_TIMEOUT_MS=3000
JWT_JWKS_CACHE_TTL_MS=300000
JWT_JWKS_REFRESH_COOLDOWN_MS=10000
