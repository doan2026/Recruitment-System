SERVICE_NAME=job-search-service
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=job
KAFKA_BROKERS=kafka:9092
JOB_EVENT_PUBLISHER_ENABLED=true
KAFKA_JOB_TOPIC=job-events
JOB_EVENT_OUTBOX_POLL_INTERVAL_MS=5000
JOB_EVENT_OUTBOX_LEASE_MS=30000
JOB_EVENT_KAFKA_REQUEST_TIMEOUT_MS=3000
JOB_EVENT_KAFKA_RETRIES=1
JOB_EVENT_KAFKA_RETRY_MAX_MS=500
JOB_EVENT_OUTBOX_BATCH_SIZE=100
JOB_EVENT_OUTBOX_RETRY_BASE_MS=1000
JOB_EVENT_OUTBOX_RETRY_MAX_MS=60000
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
ELASTICSEARCH_NODE=http://elasticsearch:9200
JOB_INDEX_QUEUE_NAME=job-search-indexing
JOB_INDEX_ATTEMPTS=8
JOB_INDEX_BACKOFF_MS=1000
JOB_INDEX_CONCURRENCY=5
JOB_INDEX_POLL_INTERVAL_MS=5000
JOB_INDEX_RECONCILE_MS=60000
JOB_INDEX_LEASE_MS=30000
JOB_INDEX_BATCH_SIZE=100
JOB_INDEX_REDIS_COMMAND_TIMEOUT_MS=2000
ELASTICSEARCH_INDEX=job_index_v3
ELASTICSEARCH_REQUEST_TIMEOUT_MS=2000
COMPANY_SERVICE_URL=http://company-service:3000
INTERNAL_API_KEY=${INTERNAL_API_KEY}
JOB_EXPIRY_INTERVAL_MS=3600000
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
