DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
INTERNAL_API_KEY=${INTERNAL_API_KEY}
# Replace both scoped placeholders; startup deliberately rejects them.
INTERNAL_API_KEY_JOB_SEARCH=replace-with-distinct-job-search-ai-key-0001
INTERNAL_API_KEY_JOB_SEARCH_CANDIDATES=replace-with-distinct-job-candidate-key-0001
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATABASE_STATEMENT_TIMEOUT_MS=2000
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
CHAT_ENABLED=false
# When enabling chat, replace both secrets with distinct 32+ byte values.
CHAT_REDIS_KEY_SECRET=replace-with-distinct-chat-redis-key-secret
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CHAT_PROVIDER_TIMEOUT_SECONDS=15
CHAT_MAX_OUTPUT_TOKENS=512
CHAT_HISTORY_TTL_SECONDS=86400
CHAT_HISTORY_MAX_TURNS=10
CHAT_RATE_WINDOW_SECONDS=60
CHAT_USER_RATE_LIMIT=10
CHAT_GLOBAL_RATE_LIMIT=200
CHAT_SESSION_LOCK_SECONDS=30
CHAT_MAX_CONCURRENT_REQUESTS=8
# Rolling opt-in. The fixed direct-service endpoint derives Candidate/CV from JWT.
CHAT_RECOMMENDATION_TOOL_ENABLED=false
CHAT_JOB_RECOMMENDATION_URL=http://job-search-service:3000/recommended
CHAT_JOB_SERVICE_ALLOWED_HOSTS=job-search-service
# Development Compose only. Production service-to-service traffic must use HTTPS.
CHAT_JOB_SERVICE_ALLOW_INSECURE_HTTP=true
CHAT_JOB_REQUEST_TIMEOUT_SECONDS=3
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
JWT_JWKS_URI=http://auth-service:8080/auth/.well-known/jwks.json
JWT_JWKS_ALLOWED_HOSTS=auth-service
# Development Compose only. Production JWKS must use HTTPS.
JWT_ALLOW_INSECURE_JWKS=true
JWT_JWKS_TIMEOUT_SECONDS=3
JWT_JWKS_CACHE_TTL_SECONDS=300
KAFKA_BROKERS=kafka:9092
KAFKA_JOB_TOPIC=job-events
KAFKA_JOB_CONSUMER_GROUP=ai-job-embedding-v1
KAFKA_JOB_CONSUMER_CLIENT_ID=ai-job-embedding-worker
KAFKA_CV_TOPIC=cv-events
KAFKA_CV_CONSUMER_GROUP=ai-cv-embedding-v1
KAFKA_CV_CONSUMER_CLIENT_ID=ai-cv-embedding-worker
KAFKA_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_SECONDS=1
KAFKA_POLL_TIMEOUT_SECONDS=1
KAFKA_RECONNECT_BACKOFF_SECONDS=5
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_CACHE=/models
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_MODEL_LOCAL_FILES_ONLY=false
EMBEDDING_DIMENSION=384
MEDIA_SERVICE_URL=http://media-service:3000
MEDIA_INTERNAL_API_KEY=replace-with-the-distinct-media-ai-service-key
MEDIA_DOWNLOAD_ALLOWED_HOSTS=api.cloudinary.com,res.cloudinary.com
MEDIA_REQUEST_TIMEOUT_SECONDS=5
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=15
MEDIA_MAXIMUM_FILE_BYTES=5242880
MEDIA_MAXIMUM_URL_TTL_SECONDS=600
CV_PDF_PARSER_TIMEOUT_SECONDS=15
CV_PDF_MAXIMUM_PAGES=100
CV_PDF_MAXIMUM_TEXT_CHARACTERS=500000
