DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
INTERNAL_API_KEY=${INTERNAL_API_KEY}
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATABASE_STATEMENT_TIMEOUT_MS=2000
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_JOB_TOPIC=job-events
KAFKA_JOB_CONSUMER_GROUP=ai-job-embedding-v1
KAFKA_JOB_CONSUMER_CLIENT_ID=ai-job-embedding-worker
KAFKA_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_SECONDS=1
KAFKA_POLL_TIMEOUT_SECONDS=1
KAFKA_RECONNECT_BACKOFF_SECONDS=5
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_CACHE=/models
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_MODEL_LOCAL_FILES_ONLY=false
EMBEDDING_DIMENSION=384
GEMINI_API_KEY=${GEMINI_API_KEY}
