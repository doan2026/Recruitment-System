SERVICE_NAME=profile-service
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=profile
MEDIA_SERVICE_URL=http://media-service:3000
MEDIA_INTERNAL_API_KEY=replace-with-a-distinct-profile-service-key
APPLICATION_SERVICE_URL=http://application-service:8080
APPLICATION_INTERNAL_API_KEY=replace-with-a-distinct-profile-to-application-key
INTERNAL_API_KEY_APPLICATION=replace-with-a-distinct-application-to-profile-key
MEDIA_REQUEST_TIMEOUT_MS=3000
APPLICATION_REQUEST_TIMEOUT_MS=3000
CV_DELETION_RECONCILE_ENABLED=true
CV_DELETION_RECONCILE_INTERVAL_SECONDS=30
CV_DELETION_RECONCILE_BATCH_SIZE=10
CV_DELETION_FENCE_LEASE_SECONDS=30
CV_DELETION_RETRY_BASE_SECONDS=5
CV_DELETION_RETRY_MAX_SECONDS=3600
CV_MEDIA_CLEANUP_ENABLED=true
CV_MEDIA_CLEANUP_INTERVAL_SECONDS=30
CV_MEDIA_CLEANUP_BATCH_SIZE=10
CV_MEDIA_CLEANUP_LEASE_SECONDS=45
CV_MEDIA_CLEANUP_RETRY_BASE_SECONDS=5
CV_MEDIA_CLEANUP_RETRY_MAX_SECONDS=3600
KAFKA_BROKERS=kafka:9092
JWT_JWKS_URI=
JWT_ALLOW_INSECURE_JWKS=false
JWT_JWKS_CACHE_TTL_MS=300000
JWT_JWKS_REFRESH_COOLDOWN_MS=10000
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
