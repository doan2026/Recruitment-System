generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CvType {
  UPLOAD
  ONLINE

  @@map("cv_type")
}

enum CvDeletionState {
  PENDING_FENCE
  SOFT_RETAINED
  HARD_DELETE_AUTHORIZED
  HARD_DELETED

  @@map("cv_deletion_state")
}

enum CvMediaCleanupStatus {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED

  @@map("cv_media_cleanup_status")
}

enum CvEventAction {
  UPSERTED
  DEACTIVATED
  DELETED

  @@map("cv_event_action")
}

enum JobPreferenceState {
  ENABLED
  DISABLED

  @@map("job_preference_state")
}

enum PreferredJobType {
  FULL_TIME
  PART_TIME
  REMOTE
  INTERNSHIP

  @@map("preferred_job_type")
}

model Profile {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @unique(map: "profiles_user_id_key") @map("user_id") @db.Uuid
  fullName               String?                 @map("full_name") @db.VarChar(160)
  headline               String?                 @db.VarChar(200)
  summary                String?
  phone                  String?                 @db.VarChar(32)
  address                String?                 @db.VarChar(500)
  avatarFileId           String?                 @map("avatar_file_id") @db.Uuid
  avatarUrl              String?                 @map("avatar_url") @db.VarChar(2048)
  avatarMediaReferenceId String?                 @unique(map: "profiles_avatar_media_reference_id_key") @map("avatar_media_reference_id") @db.Uuid
  githubUrl              String?                 @map("github_url") @db.VarChar(2048)
  linkedinUrl            String?                 @map("linkedin_url") @db.VarChar(2048)
  portfolioUrl           String?                 @map("portfolio_url") @db.VarChar(2048)
  completionRuleVersion  Int                     @default(1) @map("completion_rule_version")
  completionPercent      Int                     @default(0) @map("completion_percent")
  aggregateVersion       Int                     @default(1) @map("aggregate_version")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  educations             Education[]
  experiences            Experience[]
  skills                 Skill[]
  certificates           Certificate[]
  projects               Project[]
  cvs                    Cv[]
  cvDeletions            CvDeletionWorkflow[]
  jobPreference          CandidateJobPreference?

  @@map("profiles")
}

model CandidateJobPreference {
  candidateId        String             @id @map("candidate_id") @db.Uuid
  schemaVersion      Int                @default(1) @map("schema_version")
  state              JobPreferenceState
  version            Int                @default(1)
  consentVersion     Int?               @map("consent_version")
  consentedAt        DateTime?          @map("consented_at") @db.Timestamptz(3)
  withdrawnAt        DateTime?          @map("withdrawn_at") @db.Timestamptz(3)
  targetRoles        String[]           @default([]) @map("target_roles")
  preferredLocations String[]           @default([]) @map("preferred_locations")
  preferredJobTypes  PreferredJobType[] @default([]) @map("preferred_job_types")
  minimumSalary      Decimal?           @map("minimum_salary") @db.Decimal(15, 2)
  currency           String             @default("VND") @db.Char(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile            Profile            @relation(fields: [candidateId], references: [userId], onDelete: Cascade, onUpdate: Restrict)

  @@map("candidate_job_preferences")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  school      String    @db.VarChar(200)
  major       String?   @db.VarChar(160)
  degree      String?   @db.VarChar(120)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder, startDate], map: "educations_profile_order_idx")
  @@map("educations")
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  companyName String    @map("company_name") @db.VarChar(160)
  position    String    @db.VarChar(160)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder, startDate], map: "experiences_profile_order_idx")
  @@map("experiences")
}

model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @map("normalized_name") @db.VarChar(120)
  level          String?  @db.VarChar(40)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([profileId, normalizedName], map: "skills_profile_normalized_name_key")
  @@index([profileId, sortOrder], map: "skills_profile_order_idx")
  @@map("skills")
}

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  name          String   @db.VarChar(160)
  issuer        String   @db.VarChar(160)
  issuedAt      DateTime @map("issued_at") @db.Date
  credentialUrl String?  @map("credential_url") @db.VarChar(2048)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder, issuedAt], map: "certificates_profile_order_idx")
  @@map("certificates")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  name        String   @db.VarChar(160)
  role        String?  @db.VarChar(160)
  description String?
  url         String?  @db.VarChar(2048)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder], map: "projects_profile_order_idx")
  @@map("projects")
}

/// fileUrl is a deprecated compatibility field for legacy public CVs. New
/// private CVs use mediaReferenceId and resolve access through Media Service.
/// Application stores cvId, so the service layer must not mutate file/content
/// after a CV is first used.
model Cv {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  title                String    @db.VarChar(160)
  type                 CvType
  fileId               String    @unique(map: "cvs_file_id_key") @map("file_id") @db.Uuid
  fileUrl              String?   @map("file_url") @db.VarChar(2048)
  mediaReferenceId     String?   @unique(map: "cvs_media_reference_id_key") @map("media_reference_id") @db.Uuid
  templateId           String?   @map("template_id") @db.VarChar(100)
  contentJson          Json?     @map("content_json") @db.JsonB
  contentSchemaVersion Int?      @map("content_schema_version")
  revisionSeriesId     String?   @map("revision_series_id") @db.Uuid
  revisionNumber       Int?      @map("revision_number")
  previousRevisionId   String?   @unique(map: "cvs_previous_revision_id_key") @map("previous_revision_id") @db.Uuid
  aggregateVersion     Int       @default(1) @map("aggregate_version")
  isDefault            Boolean   @default(false) @map("is_default")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  firstUsedAt          DateTime? @map("first_used_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile              Profile   @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  revisionSeriesRoot   Cv?       @relation("CvRevisionSeries", fields: [revisionSeriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seriesRevisions      Cv[]      @relation("CvRevisionSeries")
  previousRevision     Cv?       @relation("CvRevisionChain", fields: [previousRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nextRevision         Cv?       @relation("CvRevisionChain")

  @@unique([revisionSeriesId, revisionNumber], map: "cvs_revision_series_number_key")
  @@index([userId, isDeleted, createdAt], map: "cvs_user_active_created_idx")
  @@index([userId, revisionSeriesId, revisionNumber], map: "cvs_user_revision_series_idx")
  @@map("cvs")
}

model CvDeletionWorkflow {
  cvId                     String             @id @map("cv_id") @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  deletionRequestId        String             @unique(map: "cv_deletion_workflow_request_id_key") @map("deletion_request_id") @db.Uuid
  expectedAggregateVersion Int                @map("expected_aggregate_version")
  resultAggregateVersion   Int                @map("result_aggregate_version")
  fileId                   String             @unique(map: "cv_deletion_workflow_file_id_key") @map("file_id") @db.Uuid
  mediaReferenceId         String             @unique(map: "cv_deletion_workflow_media_reference_id_key") @map("media_reference_id") @db.Uuid
  replacementDefaultCvId   String?            @map("replacement_default_cv_id") @db.Uuid
  cvCreatedAt              DateTime           @map("cv_created_at") @db.Timestamptz(3)
  deletedAt                DateTime           @map("deleted_at") @db.Timestamptz(3)
  state                    CvDeletionState    @default(PENDING_FENCE)
  fencedAt                 DateTime?          @map("fenced_at") @db.Timestamptz(3)
  firstUsedAt              DateTime?          @map("first_used_at") @db.Timestamptz(3)
  applicationCount         BigInt             @default(0) @map("application_count")
  fenceAttemptCount        Int                @default(0) @map("fence_attempt_count")
  fenceNextAttemptAt       DateTime           @default(now()) @map("fence_next_attempt_at") @db.Timestamptz(3)
  fenceLeaseOwner          String?            @map("fence_lease_owner") @db.VarChar(64)
  fenceLeaseFence          Int                @default(0) @map("fence_lease_fence")
  fenceLeaseUntil          DateTime?          @map("fence_lease_until") @db.Timestamptz(3)
  lastFenceErrorCode       String?            @map("last_fence_error_code") @db.VarChar(96)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile                  Profile            @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  cleanup                  CvMediaCleanupJob?

  @@index([userId, state, createdAt], map: "cv_deletion_workflow_user_state_idx")
  @@map("cv_deletion_workflow")
}

model CvMediaCleanupJob {
  id                  String               @id @default(uuid()) @db.Uuid
  cvId                String               @unique(map: "cv_media_cleanup_job_cv_id_key") @map("cv_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  fileId              String               @unique(map: "cv_media_cleanup_job_file_id_key") @map("file_id") @db.Uuid
  mediaReferenceId    String               @unique(map: "cv_media_cleanup_job_reference_id_key") @map("media_reference_id") @db.Uuid
  status              CvMediaCleanupStatus @default(PENDING)
  attemptCount        Int                  @default(0) @map("attempt_count")
  nextAttemptAt       DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner          String?              @map("lease_owner") @db.VarChar(64)
  leaseFence          Int                  @default(0) @map("lease_fence")
  leaseUntil          DateTime?            @map("lease_until") @db.Timestamptz(3)
  referenceReleasedAt DateTime?            @map("reference_released_at") @db.Timestamptz(3)
  fileDeletedAt       DateTime?            @map("file_deleted_at") @db.Timestamptz(3)
  lastErrorCode       String?              @map("last_error_code") @db.VarChar(96)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletion            CvDeletionWorkflow   @relation(fields: [cvId], references: [cvId], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt, leaseUntil, id], map: "cv_media_cleanup_job_due_idx")
  @@map("cv_media_cleanup_job")
}

/// Durable immutable Kafka intent. It intentionally has no relation to Cv or
/// Profile because DELETED events must outlive an unused CV hard-delete.
model CvEventOutbox {
  id               String        @id @default(uuid()) @map("event_id") @db.Uuid
  cvId             String        @map("cv_id") @db.Uuid
  candidateId      String        @map("candidate_id") @db.Uuid
  fileId           String        @map("file_id") @db.Uuid
  cvType           CvType        @map("cv_type")
  aggregateVersion Int           @map("aggregate_version")
  action           CvEventAction
  topic            String        @default("cv-events") @db.VarChar(100)
  eventKey         String        @map("event_key") @db.Uuid
  payload          Json          @db.JsonB
  attempts         Int           @default(0)
  nextAttemptAt    DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseOwner       String?       @map("lease_owner") @db.VarChar(64)
  leaseFence       Int           @default(0) @map("lease_fence")
  leaseExpiresAt   DateTime?     @map("lease_expires_at") @db.Timestamptz(3)
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(3)
  lastErrorCode    String?       @map("last_error_code") @db.VarChar(96)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cvId, aggregateVersion], map: "cv_event_outbox_cv_version_key")
  @@index([leaseExpiresAt], map: "cv_event_outbox_lease_expires_at_idx")
  @@map("cv_event_outbox")
}
