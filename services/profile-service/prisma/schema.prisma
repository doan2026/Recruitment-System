generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CvType {
  UPLOAD
  ONLINE

  @@map("cv_type")
}

model Profile {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @unique(map: "profiles_user_id_key") @map("user_id") @db.Uuid
  fullName              String?       @map("full_name") @db.VarChar(160)
  headline              String?       @db.VarChar(200)
  summary               String?
  phone                 String?       @db.VarChar(32)
  address               String?       @db.VarChar(500)
  avatarFileId          String?       @map("avatar_file_id") @db.Uuid
  avatarUrl             String?       @map("avatar_url") @db.VarChar(2048)
  githubUrl             String?       @map("github_url") @db.VarChar(2048)
  linkedinUrl           String?       @map("linkedin_url") @db.VarChar(2048)
  portfolioUrl          String?       @map("portfolio_url") @db.VarChar(2048)
  completionRuleVersion Int           @default(1) @map("completion_rule_version")
  completionPercent     Int           @default(0) @map("completion_percent")
  aggregateVersion      Int           @default(1) @map("aggregate_version")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  educations            Education[]
  experiences           Experience[]
  skills                Skill[]
  certificates          Certificate[]
  projects              Project[]
  cvs                   Cv[]

  @@map("profiles")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  school      String    @db.VarChar(200)
  major       String?   @db.VarChar(160)
  degree      String?   @db.VarChar(120)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder, startDate], map: "educations_profile_order_idx")
  @@map("educations")
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  companyName String    @map("company_name") @db.VarChar(160)
  position    String    @db.VarChar(160)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder, startDate], map: "experiences_profile_order_idx")
  @@map("experiences")
}

model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @map("normalized_name") @db.VarChar(120)
  level          String?  @db.VarChar(40)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([profileId, normalizedName], map: "skills_profile_normalized_name_key")
  @@index([profileId, sortOrder], map: "skills_profile_order_idx")
  @@map("skills")
}

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  name          String   @db.VarChar(160)
  issuer        String   @db.VarChar(160)
  issuedAt      DateTime @map("issued_at") @db.Date
  credentialUrl String?  @map("credential_url") @db.VarChar(2048)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder, issuedAt], map: "certificates_profile_order_idx")
  @@map("certificates")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  name        String   @db.VarChar(160)
  role        String?  @db.VarChar(160)
  description String?
  url         String?  @db.VarChar(2048)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder], map: "projects_profile_order_idx")
  @@map("projects")
}

/// fileUrl must be a canonical HTTPS URL confirmed by Media Service, never a
/// client-provided or short-lived signed URL. Application stores cvId, so a
/// future service layer must not mutate file/content after a CV is first used.
model Cv {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  title                String    @db.VarChar(160)
  type                 CvType
  fileId               String    @unique(map: "cvs_file_id_key") @map("file_id") @db.Uuid
  fileUrl              String    @map("file_url") @db.VarChar(2048)
  templateId           String?   @map("template_id") @db.VarChar(100)
  contentJson          Json?     @map("content_json") @db.JsonB
  contentSchemaVersion Int?      @map("content_schema_version")
  aggregateVersion     Int       @default(1) @map("aggregate_version")
  isDefault            Boolean   @default(false) @map("is_default")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  firstUsedAt          DateTime? @map("first_used_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile              Profile   @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, isDeleted, createdAt], map: "cvs_user_active_created_idx")
  @@map("cvs")
}
