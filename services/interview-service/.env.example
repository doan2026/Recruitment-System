SERVICE_NAME=interview-service
PORT=8080
DATABASE_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB}?currentSchema=interview
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
CORS_ORIGINS=http://localhost:3000
APPLICATION_SERVICE_URL=http://application-service:8080
APPLICATION_SERVICE_ALLOWED_HOSTS=application-service
APPLICATION_REQUEST_TIMEOUT_MS=2000
APPLICATION_INTERNAL_API_KEY=replace-with-a-distinct-interview-to-application-key
KAFKA_BROKERS=kafka:9092
JITSI_BASE_URL=${JITSI_BASE_URL}
