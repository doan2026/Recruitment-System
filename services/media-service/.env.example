SERVICE_NAME=media-service
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET_CV=recruitment_cv_signed
CLOUDINARY_UPLOAD_PRESET_AVATAR=recruitment_avatar_signed
CLOUDINARY_UPLOAD_PRESET_COMPANY_LOGO=recruitment_company_logo_signed
CLOUDINARY_UPLOAD_PRESET_COMPANY_IMAGE=recruitment_company_image_signed
CLOUDINARY_UPLOAD_PRESET_COMPANY_VIDEO=recruitment_company_video_signed
CLOUDINARY_UPLOAD_PRESET_CHAT_ATTACHMENT=recruitment_chat_attachment_signed
CLOUDINARY_LIVE_SMOKE=0
CLOUDINARY_LIVE_SMOKE_CONFIRM_CLOUD=
CLOUDINARY_LIVE_SMOKE_MEDIA_BASE_URL=http://127.0.0.1:3000
CLOUDINARY_LIVE_SMOKE_PDF_PATH=
CLOUDINARY_LIVE_SMOKE_IMAGE_PATH=
CLOUDINARY_LIVE_SMOKE_VIDEO_PATH=
JWT_JWKS_URI=https://auth.recruitment.local/auth/.well-known/jwks.json
JWT_ALLOW_INSECURE_JWKS=false
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=https://auth.recruitment.local
JWT_AUDIENCE=recruitment-api
INTERNAL_API_KEY_PROFILE=replace-with-a-distinct-profile-service-key
INTERNAL_API_KEY_COMPANY=replace-with-a-distinct-company-service-key
INTERNAL_API_KEY_APPLICATION=replace-with-a-distinct-application-service-key
INTERNAL_API_KEY_CHAT=replace-with-a-distinct-chat-service-key
INTERNAL_API_KEY_INTERVIEW=replace-with-a-distinct-interview-service-key
INTERNAL_API_KEY_AI=replace-with-a-distinct-ai-service-key
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_SECONDS=300
MEDIA_CLEANUP_BATCH_SIZE=5
MEDIA_CLEANUP_LEASE_SECONDS=300
MEDIA_CLEANUP_PROVIDER_TIMEOUT_SECONDS=20
MEDIA_CLEANUP_RETRY_BASE_SECONDS=30
MEDIA_CLEANUP_RETRY_MAX_SECONDS=21600
MEDIA_CLEANUP_PROVIDER_GRACE_SECONDS=300
MEDIA_CLEANUP_CLEAN_INTERVAL_SECONDS=60
MEDIA_CLEANUP_EXPIRED_RETENTION_SECONDS=86400
MEDIA_CLEANUP_STARTUP_JITTER_SECONDS=30
