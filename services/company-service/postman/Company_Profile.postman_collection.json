{
  "info": {
    "name": "Company Service - Profile, Verification and Members (C01-C03)",
    "description": "Requests are written for the Nginx gateway, which strips the /companies prefix before forwarding to Company Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "companyId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "memberAccessToken",
      "value": ""
    },
    {
      "key": "memberUserId",
      "value": ""
    },
    {
      "key": "invitationToken",
      "value": ""
    },
    {
      "key": "companySearchCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/companies/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create company",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "if (body.data && body.data.id) pm.collectionVariables.set('companyId', body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Acme Vietnam\",\n  \"description\": \"A recruitment technology company\",\n  \"industry\": \"Technology\",\n  \"size\": \"51-200\",\n  \"address\": \"Ho Chi Minh City\",\n  \"website\": \"https://acme.example\",\n  \"taxCode\": \"0312345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/companies/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            ""
          ]
        }
      }
    },
    {
      "name": "Get my company",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/companies/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "me"
          ]
        }
      }
    },
    {
      "name": "Get verified public company",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/companies/{{companyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "{{companyId}}"
          ]
        }
      }
    },
    {
      "name": "Search verified public companies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('public search succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('bounded search envelope', () => { pm.expect(body).to.have.all.keys('data', 'meta'); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta).to.have.all.keys('limit', 'hasMore', 'nextCursor'); });",
              "pm.test('public cards do not expose workflow or internal media fields', () => body.data.forEach((item) => pm.expect(item).to.have.all.keys('id', 'name', 'slug', 'industry', 'size', 'address', 'logoUrl')));",
              "pm.collectionVariables.set('companySearchCursor', body.meta.nextCursor || '');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/companies/search?q=C%C3%B4ng%20ngh%E1%BB%87&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "Công nghệ"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "cursor",
              "value": "{{companySearchCursor}}",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "Update company as OWNER",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated company description\",\n  \"website\": \"https://acme.example/careers\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/companies/{{companyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "{{companyId}}"
          ]
        }
      }
    },
    {
      "name": "Remove logo reference",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"removeLogo\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/companies/{{companyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "companies",
            "{{companyId}}"
          ]
        }
      }
    },
    {
      "name": "Admin - List pending companies",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/companies?verified_status=PENDING&page=1&limit=20"
      }
    },
    {
      "name": "Admin - Approve company",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"APPROVE\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/companies/{{companyId}}/verify"
      }
    },
    {
      "name": "Admin - Reject company",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"REJECT\",\n  \"reason\": \"Tax document is unreadable\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/companies/{{companyId}}/verify"
      }
    },
    {
      "name": "Recruiter - Resubmit rejected company",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/companies/me/submit-verification"
      }
    },
    {
      "name": "Owner - Invite company member",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.invitationToken) pm.collectionVariables.set('invitationToken', body.data.invitationToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"member@example.com\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/companies/{{companyId}}/members"
      }
    },
    {
      "name": "Member - Accept company invitation",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{memberAccessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{invitationToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/companies/invitations/accept"
      }
    },
    {
      "name": "Owner - List company members",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/companies/{{companyId}}/members"
      }
    },
    {
      "name": "Owner - Remove company member",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/companies/{{companyId}}/members/{{memberUserId}}"
      }
    },
    {
      "name": "Owner - Transfer company ownership",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/companies/{{companyId}}/members/{{memberUserId}}/transfer-ownership"
      }
    },
    {
      "name": "Recruiter - Resolve own company",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{memberAccessToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/companies/by-user/{{memberUserId}}"
      }
    }
  ]
}
