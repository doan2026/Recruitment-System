DO $$
DECLARE
  kinds text[];
  assets text[];
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'company' AND table_name = 'companies'
      AND column_name = 'aggregate_version' AND is_nullable = 'NO' AND column_default = '0'
  ) OR NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'company' AND table_name = 'companies'
      AND column_name = 'logo_media_reference_id' AND udt_name = 'uuid'
  ) OR NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'company' AND table_name = 'company_media'
      AND column_name = 'media_reference_id' AND udt_name = 'uuid'
  ) OR NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'company' AND table_name = 'company_media_upload_intents'
      AND column_name = 'cleanup_at' AND is_nullable = 'NO'
  ) OR to_regclass('company.company_media_operations') IS NULL
     OR to_regclass('company.company_media_upload_intents') IS NULL THEN
    RAISE EXCEPTION 'upgraded media columns/tables are incomplete';
  END IF;

  SELECT array_agg(e.enumlabel ORDER BY e.enumsortorder)
  INTO kinds
  FROM pg_type t
  JOIN pg_namespace n ON n.oid = t.typnamespace
  JOIN pg_enum e ON e.enumtypid = t.oid
  WHERE n.nspname = 'company' AND t.typname = 'CompanyMediaOperationKind';
  SELECT array_agg(e.enumlabel ORDER BY e.enumsortorder)
  INTO assets
  FROM pg_type t
  JOIN pg_namespace n ON n.oid = t.typnamespace
  JOIN pg_enum e ON e.enumtypid = t.oid
  WHERE n.nspname = 'company' AND t.typname = 'CompanyMediaAssetType';
  IF kinds IS DISTINCT FROM ARRAY['ATTACH_COMPENSATION', 'DETACH_CLEANUP', 'UPLOAD_INTENT_CLEANUP']
     OR assets IS DISTINCT FROM ARRAY['COMPANY_LOGO', 'COMPANY_IMAGE', 'COMPANY_VIDEO'] THEN
    RAISE EXCEPTION 'media enum contract mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM pg_indexes
    WHERE schemaname = 'company' AND indexname = 'companies_logo_media_reference_id_key'
      AND indexdef LIKE 'CREATE UNIQUE INDEX%'
  ) OR NOT EXISTS (
    SELECT 1 FROM pg_indexes
    WHERE schemaname = 'company' AND indexname = 'company_media_media_reference_id_key'
      AND indexdef LIKE 'CREATE UNIQUE INDEX%'
  ) OR NOT EXISTS (
    SELECT 1 FROM pg_constraint con
    JOIN pg_class c ON c.oid = con.conrelid
    JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = 'company' AND c.relname = 'company_media_upload_intents'
      AND con.conname = 'company_media_upload_intents_company_id_fkey'
      AND con.contype = 'f' AND con.confdeltype = 'c'
  ) THEN
    RAISE EXCEPTION 'media unique/FK contract mismatch';
  END IF;

  IF (SELECT count(*) FROM company.companies
      WHERE aggregate_version = 0 AND logo_media_reference_id IS NULL) <> 2
     OR (SELECT count(*) FROM company.company_media WHERE media_reference_id IS NULL) <> 2
     OR (SELECT count(*) FROM company.company_media_operations) <> 0
     OR (SELECT count(*) FROM company.company_media_upload_intents) <> 0 THEN
    RAISE EXCEPTION 'legacy defaults changed during upgrade';
  END IF;
END $$;

DO $$
DECLARE
  actions text[];
  columns_contract text[];
  migrations text[];
BEGIN
  SELECT array_agg(e.enumlabel ORDER BY e.enumsortorder)
  INTO actions
  FROM pg_type t
  JOIN pg_namespace n ON n.oid = t.typnamespace
  JOIN pg_enum e ON e.enumtypid = t.oid
  WHERE n.nspname = 'company' AND t.typname = 'CompanyAuditAction';
  IF actions IS DISTINCT FROM ARRAY[
    'VERIFICATION_APPROVED',
    'VERIFICATION_REJECTED',
    'OWNERSHIP_TRANSFERRED'
  ] THEN
    RAISE EXCEPTION 'company audit action enum contract mismatch';
  END IF;

  SELECT array_agg(
    concat_ws('|',
      column_name,
      data_type,
      udt_name,
      is_nullable,
      CASE WHEN column_default IS NULL THEN 'NO_DEFAULT' ELSE 'HAS_DEFAULT' END
    ) ORDER BY ordinal_position
  )
  INTO columns_contract
  FROM information_schema.columns
  WHERE table_schema = 'company' AND table_name = 'company_audit_logs';
  IF columns_contract IS DISTINCT FROM ARRAY[
    'id|uuid|uuid|NO|NO_DEFAULT',
    'company_id|uuid|uuid|NO|NO_DEFAULT',
    'action|USER-DEFINED|CompanyAuditAction|NO|NO_DEFAULT',
    'actor_id|uuid|uuid|NO|NO_DEFAULT',
    'target_user_id|uuid|uuid|YES|NO_DEFAULT',
    'resulting_aggregate_version|integer|int4|NO|NO_DEFAULT',
    'from_verification_status|USER-DEFINED|CompanyVerificationStatus|YES|NO_DEFAULT',
    'to_verification_status|USER-DEFINED|CompanyVerificationStatus|YES|NO_DEFAULT',
    'reason|character varying|varchar|YES|NO_DEFAULT',
    'created_at|timestamp with time zone|timestamptz|NO|HAS_DEFAULT'
  ] THEN
    RAISE EXCEPTION 'company audit column contract mismatch: %', columns_contract;
  END IF;

  IF to_regclass('company.company_audit_logs') IS NULL
     OR NOT EXISTS (
       SELECT 1
       FROM pg_constraint con
       WHERE con.conrelid = 'company.company_audit_logs'::regclass
         AND con.conname = 'company_audit_logs_pkey'
         AND con.contype = 'p'
         AND con.convalidated
     )
     OR NOT EXISTS (
       SELECT 1
       FROM pg_constraint con
       WHERE con.conrelid = 'company.company_audit_logs'::regclass
         AND con.conname = 'company_audit_logs_positive_version_check'
         AND con.contype = 'c'
         AND con.convalidated
     )
     OR NOT EXISTS (
       SELECT 1
       FROM pg_constraint con
       WHERE con.conrelid = 'company.company_audit_logs'::regclass
         AND con.conname = 'company_audit_logs_action_shape_check'
         AND con.contype = 'c'
         AND con.convalidated
     ) THEN
    RAISE EXCEPTION 'company audit table/check constraint contract mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_constraint con
    WHERE con.conrelid = 'company.company_audit_logs'::regclass
      AND con.confrelid = 'company.companies'::regclass
      AND con.conname = 'company_audit_logs_company_id_fkey'
      AND con.contype = 'f'
      AND con.confdeltype = 'r'
      AND con.confupdtype = 'r'
      AND con.convalidated
  ) THEN
    RAISE EXCEPTION 'company audit FK must RESTRICT company delete/update';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_index i
    WHERE i.indexrelid = 'company.company_members_one_owner_per_company_key'::regclass
      AND i.indrelid = 'company.company_members'::regclass
      AND i.indisunique
      AND i.indisvalid
      AND i.indisready
      AND i.indnkeyatts = 1
      AND pg_get_indexdef(i.indexrelid, 1, true) = 'company_id'
      AND pg_get_expr(i.indpred, i.indrelid) LIKE '%OWNER%'
  ) THEN
    RAISE EXCEPTION 'partial unique one-OWNER index contract mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_index i
    WHERE i.indexrelid = 'company.company_audit_logs_company_id_created_at_id_idx'::regclass
      AND i.indrelid = 'company.company_audit_logs'::regclass
      AND NOT i.indisunique
      AND i.indisvalid
      AND i.indisready
      AND i.indpred IS NULL
      AND i.indnkeyatts = 3
      AND pg_get_indexdef(i.indexrelid, 1, true) = 'company_id'
      AND pg_get_indexdef(i.indexrelid, 2, true) = 'created_at'
      AND pg_get_indexdef(i.indexrelid, 3, true) = 'id'
  ) OR NOT EXISTS (
    SELECT 1
    FROM pg_index i
    WHERE i.indexrelid = 'company.company_audit_logs_actor_id_created_at_idx'::regclass
      AND i.indrelid = 'company.company_audit_logs'::regclass
      AND NOT i.indisunique
      AND i.indisvalid
      AND i.indisready
      AND i.indpred IS NULL
      AND i.indnkeyatts = 2
      AND pg_get_indexdef(i.indexrelid, 1, true) = 'actor_id'
      AND pg_get_indexdef(i.indexrelid, 2, true) = 'created_at'
  ) OR NOT EXISTS (
    SELECT 1
    FROM pg_index i
    WHERE i.indexrelid = 'company.company_audit_logs_company_id_resulting_aggregate_version_key'::regclass
      AND i.indrelid = 'company.company_audit_logs'::regclass
      AND i.indisunique
      AND i.indisvalid
      AND i.indisready
      AND i.indpred IS NULL
      AND i.indnkeyatts = 2
      AND pg_get_indexdef(i.indexrelid, 1, true) = 'company_id'
      AND pg_get_indexdef(i.indexrelid, 2, true) = 'resulting_aggregate_version'
  ) THEN
    RAISE EXCEPTION 'company audit index contract mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_proc p
    JOIN pg_namespace n ON n.oid = p.pronamespace
    JOIN pg_language l ON l.oid = p.prolang
    WHERE n.nspname = 'company'
      AND p.proname = 'reject_company_audit_log_mutation'
      AND pg_get_function_identity_arguments(p.oid) = ''
      AND p.prorettype = 'trigger'::regtype
      AND l.lanname = 'plpgsql'
      AND NOT p.prosecdef
      AND p.prosrc LIKE '%55000%'
      AND p.prosrc LIKE '%append-only%'
  ) THEN
    RAISE EXCEPTION 'company audit append-only trigger function contract mismatch';
  END IF;

  IF (
    SELECT count(*)
    FROM pg_trigger t
    WHERE t.tgrelid = 'company.company_audit_logs'::regclass
      AND NOT t.tgisinternal
      AND t.tgenabled = 'O'
      AND t.tgfoid = 'company.reject_company_audit_log_mutation()'::regprocedure
      AND t.tgname IN (
        'company_audit_logs_reject_update_delete',
        'company_audit_logs_reject_truncate'
      )
  ) <> 2 OR NOT EXISTS (
    SELECT 1
    FROM pg_trigger t
    WHERE t.tgrelid = 'company.company_audit_logs'::regclass
      AND t.tgname = 'company_audit_logs_reject_update_delete'
      AND t.tgtype = 27
  ) OR NOT EXISTS (
    SELECT 1
    FROM pg_trigger t
    WHERE t.tgrelid = 'company.company_audit_logs'::regclass
      AND t.tgname = 'company_audit_logs_reject_truncate'
      AND t.tgtype = 34
  ) THEN
    RAISE EXCEPTION 'company audit append-only trigger contract mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_proc p
    JOIN pg_namespace n ON n.oid = p.pronamespace
    JOIN pg_language l ON l.oid = p.prolang
    WHERE n.nspname = 'company'
      AND p.proname = 'fold_public_company_search'
      AND p.prokind = 'f'
      AND p.pronargs = 1
      AND pg_get_function_identity_arguments(p.oid) = 'value text'
      AND p.prorettype = 'text'::regtype
      AND l.lanname = 'sql'
      AND p.provolatile = 'i'
      AND p.proparallel = 's'
      AND p.proisstrict
      AND NOT p.prosecdef
      AND NOT p.proleakproof
  ) THEN
    RAISE EXCEPTION 'public Company search fold function property contract mismatch';
  END IF;

  IF company.fold_public_company_search('Công nghệ Đà Nẵng')
       IS DISTINCT FROM 'cong nghe da nang'
     OR company.fold_public_company_search(
       U&'Co\0302ng nghe\0302\0323 \0110a\0300 Na\0306\0303ng'
     ) IS DISTINCT FROM 'cong nghe da nang'
     OR company.fold_public_company_search(
       '  CÔNG---NGHỆ / ĐÀ_NẴNG!!!  '
     ) IS DISTINCT FROM 'cong nghe da nang'
     OR company.fold_public_company_search('Công ty 24/7')
       IS DISTINCT FROM 'cong ty 24 7'
     OR company.fold_public_company_search(NULL) IS NOT NULL THEN
    RAISE EXCEPTION 'public Company search fold function behavior mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_index i
    JOIN pg_class index_class ON index_class.oid = i.indexrelid
    JOIN pg_namespace index_namespace
      ON index_namespace.oid = index_class.relnamespace
    JOIN pg_class table_class ON table_class.oid = i.indrelid
    JOIN pg_namespace table_namespace
      ON table_namespace.oid = table_class.relnamespace
    JOIN pg_am access_method ON access_method.oid = index_class.relam
    WHERE index_namespace.nspname = 'company'
      AND index_class.relname =
        'companies_public_verified_normalized_name_id_idx'
      AND table_namespace.nspname = 'company'
      AND table_class.relname = 'companies'
      AND access_method.amname = 'btree'
      AND NOT i.indisunique
      AND NOT i.indisprimary
      AND NOT i.indisexclusion
      AND i.indisvalid
      AND i.indisready
      AND i.indislive
      AND i.indnkeyatts = 2
      AND i.indnatts = 2
      AND i.indexprs IS NULL
      AND pg_get_indexdef(i.indexrelid, 1, true) = 'normalized_name'
      AND pg_get_indexdef(i.indexrelid, 2, true) = 'id'
      AND (
        SELECT opclass_namespace.nspname || '.' || opclass.opcname
        FROM pg_opclass opclass
        JOIN pg_namespace opclass_namespace
          ON opclass_namespace.oid = opclass.opcnamespace
        WHERE opclass.oid = i.indclass[0]
      ) = 'pg_catalog.text_ops'
      AND (
        SELECT opclass_namespace.nspname || '.' || opclass.opcname
        FROM pg_opclass opclass
        JOIN pg_namespace opclass_namespace
          ON opclass_namespace.oid = opclass.opcnamespace
        WHERE opclass.oid = i.indclass[1]
      ) = 'pg_catalog.uuid_ops'
      AND i.indoption[0] = 0
      AND i.indoption[1] = 0
      AND pg_get_expr(i.indpred, i.indrelid, true) =
        'verified_status = ''VERIFIED''::company."CompanyVerificationStatus"'
  ) THEN
    RAISE EXCEPTION 'public Company keyset B-tree index contract mismatch';
  END IF;

  IF NOT EXISTS (
    SELECT 1
    FROM pg_index i
    JOIN pg_class index_class ON index_class.oid = i.indexrelid
    JOIN pg_namespace index_namespace
      ON index_namespace.oid = index_class.relnamespace
    JOIN pg_class table_class ON table_class.oid = i.indrelid
    JOIN pg_namespace table_namespace
      ON table_namespace.oid = table_class.relnamespace
    JOIN pg_am access_method ON access_method.oid = index_class.relam
    WHERE index_namespace.nspname = 'company'
      AND index_class.relname = 'companies_public_verified_search_tsv_idx'
      AND table_namespace.nspname = 'company'
      AND table_class.relname = 'companies'
      AND access_method.amname = 'gin'
      AND NOT i.indisunique
      AND NOT i.indisprimary
      AND NOT i.indisexclusion
      AND i.indisvalid
      AND i.indisready
      AND i.indislive
      AND i.indnkeyatts = 1
      AND i.indnatts = 1
      AND i.indexprs IS NOT NULL
      AND pg_get_indexdef(i.indexrelid, 1, true) =
        'to_tsvector(''simple''::regconfig, company.fold_public_company_search(name::text))'
      AND pg_get_expr(i.indexprs, i.indrelid, true) =
        'to_tsvector(''simple''::regconfig, company.fold_public_company_search(name::text))'
      AND (
        SELECT opclass_namespace.nspname || '.' || opclass.opcname
        FROM pg_opclass opclass
        JOIN pg_namespace opclass_namespace
          ON opclass_namespace.oid = opclass.opcnamespace
        WHERE opclass.oid = i.indclass[0]
      ) = 'pg_catalog.tsvector_ops'
      AND i.indoption[0] = 0
      AND pg_get_expr(i.indpred, i.indrelid, true) =
        'verified_status = ''VERIFIED''::company."CompanyVerificationStatus"'
  ) THEN
    RAISE EXCEPTION 'public Company full-text GIN index contract mismatch';
  END IF;

  SELECT array_agg(migration_name ORDER BY started_at, migration_name)
  INTO migrations
  FROM company."_prisma_migrations"
  WHERE finished_at IS NOT NULL AND rolled_back_at IS NULL;
  IF migrations IS DISTINCT FROM ARRAY[
    '20260822000000_company_profile',
    '20260824000000_company_members',
    '20260828000000_company_media_ownership',
    '20260829000000_company_audit_log',
    '20260829100000_company_public_search'
  ] OR EXISTS (
    SELECT 1
    FROM company."_prisma_migrations"
    WHERE finished_at IS NULL OR rolled_back_at IS NOT NULL
  ) THEN
    RAISE EXCEPTION 'company migration order/ledger contract mismatch: %', migrations;
  END IF;

  IF EXISTS (SELECT 1 FROM company.company_audit_logs) THEN
    RAISE EXCEPTION 'legacy upgrade must not synthesize company audit actors/events';
  END IF;
END $$;
