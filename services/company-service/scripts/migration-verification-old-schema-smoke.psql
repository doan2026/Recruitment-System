UPDATE company.companies SET description = 'Updated probe'
WHERE id = '99999999-9999-4999-8999-999999999991';
DO $$ BEGIN
  IF (SELECT count(*) FROM company.companies
      WHERE id = '99999999-9999-4999-8999-999999999991'
        AND description = 'Updated probe') <> 1 THEN
    RAISE EXCEPTION 'old-schema read/update failed';
  END IF;
END $$;
DELETE FROM company.companies WHERE id = '99999999-9999-4999-8999-999999999991';
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM company.company_members
             WHERE company_id = '99999999-9999-4999-8999-999999999991')
     OR EXISTS (SELECT 1 FROM company.company_media
                WHERE company_id = '99999999-9999-4999-8999-999999999991')
     OR EXISTS (SELECT 1 FROM company.company_invitations
                WHERE company_id = '99999999-9999-4999-8999-999999999991') THEN
    RAISE EXCEPTION 'old-schema cascade cleanup failed';
  END IF;
END $$;
