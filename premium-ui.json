{
  "profile": "product-admin",
  "sourceRoots": [
    "frontend/app",
    "frontend/components",
    "frontend/lib"
  ],
  "locale": "vi-VN",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "CRUD"
  ],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native",
    "Form": "shared-field-policy",
    "Scrollbar": "global-stylesheet",
    "CRUD": "route-and-api-adapter"
  },
  "requiredCommands": [
    "test",
    "e2e",
    "typecheck",
    "build"
  ],
  "commands": {
    "test": "npm run test",
    "e2e": "npm run test:e2e",
    "typecheck": "npm run typecheck",
    "build": "npm run build"
  },
  "evidence": {
    "apiClient": "frontend/lib/apiClient.test.ts",
    "gatewayE2E": "frontend/tests/e2e/person2-gateway.spec.ts",
    "build": "frontend/.next/build-manifest.json",
    "fullFlowFixes": "frontend/tests/e2e/person2-flow-fixes.spec.ts",
    "companyProfile": "frontend/tests/e2e/company-profile-edit.spec.ts",
    "sessionApi": "frontend/lib/person2Flow.test.ts",
    "workspaceConsistency": "frontend/tests/e2e/workspace-consistency.spec.ts",
    "authConsistency": "frontend/tests/e2e/auth-consistency.spec.ts",
    "publicLogout": "frontend/tests/e2e/public-logout.spec.ts"
  }
}
